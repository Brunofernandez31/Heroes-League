<%- include('partials/headers') %>

    <!-- Formulaire de connexion -->

    <h2 class="h2_login" id="h2_login"><em>-</em><em>Connexion</em><em>-</em></h2>

    <section class="connexion">

        <form id="connexion_form">

            <fieldset>
                <label for="email">Veuillez renseigner votre email</label>
                <input type="text" name ="email" id="email_connexion" placeholder="test@test.com">
            </fieldset>
            <fieldset>
                <label for="password">Veuillez renseigner votre mot de passe</label>
                <input type="text" name ="password" id="password_connexion" placeholder="motdepasse123">
            </fieldset>

            <button type="submit" form="connexion_form" id="send_connexion" >Confirmer</button>
            <a href="/">Retour à l'accueil</a>
    </section>

<script defer src="/script/auth.script.js"></script>

<%- include('partials/footer') %>