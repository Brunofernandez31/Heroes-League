<%- include('partials/header') %>

    <!-- Formulaire de connexion -->

    <h2 class="h2_login" id="h2_login"><em>-</em><em> Connexion </em><em>-</em></h2>

    <section class="login">

        <form id="login_form">

            <fieldset>
                <label for="email">Veuillez renseigner votre email</label>
                <input type="text" name ="email" id="email_login" placeholder="test@test.com">
            </fieldset>
            <fieldset>
                <label for="password">Veuillez renseigner votre mot de passe</label>
                <input type="text" name ="password" id="password_login" placeholder="motdepasse123">
            </fieldset>

            <button type="submit" form="login_form" id="send_login" >Confirmer</button>
            <a href="/" class="button_link">Retour à l'accueil</a>
    </section>

<script defer src="/script/auth_login.script.js"></script>

<%- include('partials/footer') %>