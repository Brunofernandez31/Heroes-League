<%- include('partials/header') %>

<!-- Formulaire sauvez-moi ! -->

        <h2 class="h2_help_me" id="h2_help_me"><em>-</em> Sauvez-moi ! <em>-</em></h2>

        <section class="help_me">

            <form id="help_me_form" action="/sauvez_moi" method="POST">
                <fieldset>
                    <label for="user_name">Nom</label>
                    <input type="text" name="user_name" id="user_name" aria-label="Mettez votre nom">
                </fieldset>

                <fieldset>
                    <label for="user_mail">Email</label>
                    <input type="email" name="user_mail" id="user_mail" aria-label="Mettez votre Email">
                </fieldset>

                <fieldset>
                    <label for="user_city">Ville</label>
                    <input type="text" name="user_city" id="user_city" aria-label="Mettez votre ville">
                </fieldset>

                <fieldset>
                    <label for="choice_urgence">Quel degrè d'urgence</label>
                    <select name="choice_urgence" id="choice_urgence">
                        <option value="hebdomadaire" selected>Dans les 7 jours</option>
                        <option value="threeDays"> Dans les 3 jours</option>
                        <option value="immediate">Immédiatement</option>
                    </select>
                </fieldset>

                <fieldset>
                    <label for="user_message">Message</label>
                    <textarea name="user_message" id="user_message" aria-label="Indiquez votre message"></textarea>
                </fieldset>

                <button type="submit" form="help_me_form"
                    aria-label="Cliquez pour envoyer le formulaire">Envoyer</button>
            </form>

        </section>
<%- include('partials/footer') %>