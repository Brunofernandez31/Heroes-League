<%- include('partials/header') %>
        <!-- Les services -->

        <h2 id="h2_services"><em>-</em> Nos <em>Supers</em> Services <em>-</em></h2>

        <section class="services">
            <article class="article_service_demenagement">
                <h3>Super déménagement</h3>
                <p class="description_h3">Pour des déménagements sans effort et sans casse* !</p>
                <button>À partir de 233 €</button>
                <p class="infos_services">* Nous ne pouvons malheureusement pas garantir que vos objets fragiles ou
                    votre chat Gribouille survivront à un combat épique entre super-vilains lors du trajet.</p>
            </article>

            <article class="article_service_repas">
                <h3>Livraison de Repas</h3>
                <p class="description_h3">Pour des livraisons super-soniques*</p>
                <button>À partir de 12 €</button>
                <p class="infos_services">
                    * Pour éviter tout dommage à votre porte, merci de la laisser ouverte, certains super-héros n'ont
                    pas conscience de leur force. Vous pouvez souscrire à notre assurance Porte en vrac pour 5 € de
                    plus.
                </p>
            </article>

            <article class="article_service_bouchons">
                <h3>Z'héro Bouchons</h3>
                <p class="description_h3">Pour les clients pressés !*</p>
                <button>1,33 €/km</button>
                <p class="infos_services">
                    * Le mode de déplacement peut être différent en fonction de la disponibilité des héros. Merci de
                    préciser à la commande si vous avez le mal des transports soniques.
                </p>
            </article>

            <article class="article_service_soiree">
                <h3>Sauvetage de soirée</h3>
                <p class="description_h3">Pour les soirées booooring !</p>
                <button>À partir de 50 €/h</button>
                <p class="infos_services">
                    * Nous ne pouvons malheureusement pas garantir que votre super-héros ne se fera pas la malle si la
                    soirée n'est pas sauvable.
                </p>
            </article>

            <article class="article_service_moral">
                <h3>Moral à Z'héro</h3>
                <p class="description_h3">Pour les jours gris et les cœurs lourds, des héros au moral d'acier.*</p>
                <button>À partir de 100 €</button>
                <p class="infos_services">
                    * Il peut arriver que le moral de votre héros ne soit pas au beau fixe et vous bassine avec sa
                    défaite de la veille, dans ce cas, nous vous remboursons 50 % de la prestation.
                </p>
            </article>
        </section>
<%- include('partials/footer') %>