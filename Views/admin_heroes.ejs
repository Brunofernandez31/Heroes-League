<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<%- include('partials/header') %>
    <!-- Les héros -->

    <h2 id="h2_heros"><em>-</em> Nos <em>Supers</em> héros <em>-</em></h2>

    <div id = "toast"></div>
    <section class="heros">
        <% heroes.forEach((hero, index)=> { %>

            <article class="article_hero article_hero_<%= hero.name %> <%= index >= 3 ? 'hidden-hero' : '' %>">
                <!-- article_hero est la classe fixe, commune à tous les articles -->
                <!-- article_hero_<%=hero.name%> reste pour le style individuel -->

                <img class="img_hero" data-id="<%=hero.id_hero%>" src="/ressources/images/<%=hero.img_hero%>"
                    alt="<%=hero.firstname%> <%=hero.lastname%>">
                <button class="btn-delete" data-id="<%=hero.id_hero%>" title="Supprimer">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
                <div class="overlay">
                    <p class="title_hero">
                        <%=hero.firstname%> <%=hero.lastname%>
                    </p>
                    <p class="description_hero"> Avantage : <%=hero.advantage%>
                        Désavantage : <%=hero.disadvantage%>
                    </p>
                </div>
            </article>
            <% }); %>
    </section>

    <div class="button_heros">
        <div class="button_rangement">
            <button id="show-more-heroes">Tous nos héros</button>
            <a href="/" class="button_link">Retour à l'accueil</a>
        </div>
    </div>

    <script defer src="/script/heroesAdmin.script.js"></script>
    <%- include('partials/footer') %>