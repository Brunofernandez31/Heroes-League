<%- include('partials/header') %>

    <!-- Formulaire d'inscription -->

    <h2 class="h2_register" id="h2_register"><em>-</em><em> Inscription </em><em>-</em></h2>
        <div id="show" class="show"></div>
    <section class="register">

        <form id="register_form">

            <fieldset>
                <label for="email">Veuillez renseigner votre email</label>
                <input type="text" name ="email" id="email_register" placeholder="test@test.com">
            </fieldset>
            <fieldset>
                <label for="password">Veuillez renseigner votre mot de passe</label>
                <input type="text" name ="password" id="password_register" placeholder="motdepasse123">
            </fieldset>
            <fieldset>
                <label for="firstName">Veuillez renseigner votre nom</label>
                <input type="text" name ="firstName" id="firstName_register" placeholder="Coco">
            </fieldset>
            <fieldset>
                <label for="lastName">Veuillez renseigner votre prénom</label>
                <input type="text" name ="lastName" id="lastName_register" placeholder="Rico">
            </fieldset>

            <div class="button_rangement">
                <button type="submit" form="register_form" id="send_register">Confirmer</button>
                <a href="/" class="button_link">Retour à l'accueil</a>
            </div>
    </section>

<script defer src="/script/auth_register.script.js"></script>

<%- include('partials/footer') %>