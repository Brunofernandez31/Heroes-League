<%- include('partials/header') %>

    <!-- Formulaire rapport de mission -->

    <h2 class="h2_mission_report" id="h2_mission_report"><em>-</em> Rapport de <em>Mission n°<%=mission.id_mission%>
        </em> <em>-</em></h2>

    <section class="mission_report">

        <form id="mission_report_form" action="/rapport_mission/<%=mission.id_mission%>" method="POST">
        <!-- Ajouter un champ caché dans le HTML pour le récupérer dans le front facilement -->
        <input type="hidden" id="mission_id" value="<%= mission.id_mission %>">

            <!-- Sélection du héros -->
            <fieldset>
                <label for="hero_select">Rédigé par </label>
                <select name="hero_id" id="hero_select" required>
                    <option value="" selected disabled>Choisir un héros</option>
                    <% heroes.forEach(hero=> { %>
                        <option value="<%= hero.id_hero %>" data-price="<%= hero.price_per_hour %>">
                            <%= hero.name %>
                        </option>
                        <% }); %>
                </select>
            </fieldset>

            <!-- Affichage du taux horaire -->
            <fieldset>
                <label for="hourly_rate">Taux horaire du héros</label>
                <input type="text" id="hourly_rate" readonly placeholder="Taux horaire">
                <!-- Readonly pour éviter que l'utilisateur triche et modifie lui même le prix -->
            </fieldset>

            <!-- Degré d'urgence -->
            <fieldset class="urgency_fieldset">
                <legend>Degré d'urgence de la mission</legend>
                <div class="degre_urgency">
                    <label for="urgency">Urgence</label>
                    <input type="text" id="urgency" readonly
                        value="<%= mission.urgency === 'hebdomadaire' ? 'Normal (7 jours)' : mission.urgency === 'threeDays' ? 'Urgent (3 jours)' : 'Immédiat' %>">
                </div>
            </fieldset>

            <!-- Durée de la mission -->
            <fieldset>
                <label for="mission_duration">Durée de la mission (en demi-heures)</label>
                <input type="number" name="mission_duration" id="mission_duration" min="0.5" step="0.5" required
                    aria-label="Indiquez la durée en heures">
            </fieldset>

            <!-- Statut de la mission (réussite/échec) -->
            <fieldset class="mission_status_fieldset">
                <legend>Résultat de la mission</legend>
                <!-- Placer un seul required sur un des deux boutons radio, 
            le navigateur comprendra qu'il en faudra au moins un obligatoirement -->
                <div class="radio_group">
                    <input type="radio" name="mission" id="mission_success" value="success" required>
                    <label for="mission_success">Mission réussie</label>
                </div>

                <div class="radio_group">
                    <input type="radio" name="mission" id="mission_failed" value="failed">
                    <label for="mission_failed">Mission échouée</label>
                </div>
            </fieldset>

            <!-- Commentaires optionnels -->
            <fieldset>
                <label for="mission_comments">Commentaires (optionnel)</label>
                <textarea name="mission_comments" id="mission_comments"
                    aria-label="Ajoutez des commentaires sur la mission"></textarea>
            </fieldset>

            <!-- Prévisualisation du rapport -->

            <button type="button" id="preview_rapport" aria-label="Afficher le rapport de mission">
                Afficher le rapport
            </button>

            <!-- Modal du rapport avec envoi update vers bdd -->

            <div class="modal" id="preview_modal" style="display: none;">
                <div class="modal_content">
                    <h3>Récapitulatif</h3>
                        <p>Héros : <span id="modal_hero"></span></p>
                        <p>Taux horaire : <span id="modal_taux"></span>€</p>
                        <p>Durée : <span id="modal_duration"></span></p>
                        <p>Délai d'urgence réalisé <span id="modal_urgency"></span></p>
                        <p>Commentaire laissé par le client : <span id="modal_comments"></span></p>
                        <p>Montant total : <span id="modal_total"></span>€</p>
                        <p>La mission a été un : <span id="modal_result">La mission est un </span></p>
                    <button type="submit" form="mission_report_form" id="send_rapport" >Envoyer le rapport</button>
                    <button type="button" id="close_modal">Annuler</button>
                </div>
            </div>
        </form>

    </section>

    <script defer src="/script/rapport.script.js"></script>
    <%- include('partials/footer') %>