<%- include('partials/header') %>

<!-- Les héros -->

        <h2 id="h2_heros"><em>-</em> Nos <em>Supers</em> héros <em>-</em></h2>

        <section class="heros">
<% heroes.forEach(hero => { %>
            <article class="article_hero_<%=hero.article%>">
                <img src="<%=hero.img%>" alt="<%=hero.article%>">
                <div class="overlay">
                    <p class="title_hero"><%=hero.name%></p>
                    <p class="description_hero"><%=hero.description%>
                    </p>
                </div>
            </article>
<% }); %>
        </section>

        <div class="button_heros">
            <button><a href="https://fr.wikipedia.org/wiki/Liste_de_super-h%C3%A9ros_au_cin%C3%A9ma">
                    Tous nos héros</a></button>
        </div>

<%- include('partials/footer') %>