# DATABASE
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=heroes_db
POSTGRES_PORT=5433
JWT_SECRET=
# API
DATABASE_URL=postgres://username:password@heroes_db:5432/heroes_db
# heroes_db:5432 (nom du service + port interne du container)
PORT=3000

# ADMINER (l'interface web pour gérer la bdd)
ADMINER_PORT=8080

# Maintenant qu'on on va faire un docker compose up, il va falloir lancer la commande avec l'option:
# --env-file .env.docker
# Exemple: docker compose --env-file .env.docker up -d
# Pour stopper docker-compose, il faudra faire :
# docker compose --env-file .env.docker down